{
  "name": "auto",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "auth-proxy": "bun packages/microsoft-auth/proxy.ts",
    "export-src": "bun scripts/export-src.ts",
    "export-html": "bun scripts/export-html.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/bun": "^1.4.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "fflate": "^0.8.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "turbo": "^2.5.8",
    "typescript": "^6",
    "vite": "^8",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
